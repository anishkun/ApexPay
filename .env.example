# ApexPay environment variables
# Copy this file to .env and fill in real values. NEVER commit .env (it is gitignored).

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/ApexDB
DB_USERNAME=postgres
# Required for local dev -- there is no committed default password.
DB_PASSWORD=changeme

# --- RabbitMQ ---
# guest/guest only works for local connections; production MUST use real credentials.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Security (HTTP Basic; Spring Security) ---
# Service-to-service credentials for the payment API and the ops/observability
# endpoints. The plaintext below is BCrypt-encoded at startup (no hashes committed).
# CHANGE IN PRODUCTION -- the "changeit" defaults are for local/dev/test ONLY and
# must never reach a real deployment. Passwords are never written to logs.
# Payment API caller (ROLE_USER): can POST /api/v1/transfers and create accounts.
API_USER=apiuser
API_PASSWORD=changeit
# Ops caller (ROLE_ACTUATOR + ROLE_USER): can scrape /actuator/prometheus & /metrics.
ACTUATOR_USER=ops
ACTUATOR_PASSWORD=changeit

# --- Logging ---
# Console log format: ecs (default, structured JSON), logstash, gelf,
# or set to empty (LOG_FORMAT=) for plain human-readable text in local dev.
# Note: tests always log plain text (src/test/resources shadows this config).
LOG_FORMAT=ecs

# --- Tracing ---
# Fraction of requests sampled for distributed tracing (0.0-1.0).
TRACE_SAMPLING=1.0
# Ship spans to an OTLP collector? false (default) = spans stay in-process
# (traceId/spanId still appear in logs), true = export to OTLP_ENDPOINT.
TRACING_EXPORT_ENABLED=false
# OTLP HTTP traces endpoint of your collector. Only used when export is enabled.
OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- JPA / Hibernate ---
# Schema management strategy. Local dev: update. Production: validate or none.
DDL_AUTO=update
# SQL statement logging. Keep false in production (can leak data into logs).
SHOW_SQL=false
