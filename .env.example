# ApexPay environment variables
# Copy this file to .env and fill in real values. NEVER commit .env (it is gitignored).

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/ApexDB
DB_USERNAME=postgres
# Required for local dev -- there is no committed default password.
DB_PASSWORD=changeme

# --- RabbitMQ ---
# guest/guest only works for local connections; production MUST use real credentials.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- JPA / Hibernate ---
# Schema management strategy. Local dev: update. Production: validate or none.
DDL_AUTO=update
# SQL statement logging. Keep false in production (can leak data into logs).
SHOW_SQL=false
